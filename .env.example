# Configuración de entorno para ObraTech (Backend)
# Copia este archivo a .env y reemplaza los valores por tus credenciales locales reales.
JWT_SECRET=obratech_jwt_secret_key_development_2026_at_least_256_bits_long!
APP_FRONTEND_URL=http://localhost:5173
APP_MAIL_FROM=no-reply@obratech.local

# Google OAuth (requerido para habilitar login con Google)
# Debes obtener estos valores en Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=